AGENT_FEASIBILITY_MAX_OUTPUT_TOKENS=4096
AGENT_FEASIBILITY_TIMEOUT_MS=60000
AGENT_FEASIBILITY_INPUT_COST_PER_MILLION=
AGENT_FEASIBILITY_OUTPUT_COST_PER_MILLION=
AGENT_SCOPE_API_KEY=
AGENT_SCOPE_MODEL=openai/gpt-oss-120b
AGENT_SCOPE_MAX_OUTPUT_TOKENS=4096
AGENT_SCOPE_TIMEOUT_MS=60000
AGENT_SCOPE_INPUT_COST_PER_MILLION=
AGENT_SCOPE_OUTPUT_COST_PER_MILLION=
AGENT_TECHNOLOGY_API_KEY=
AGENT_TECHNOLOGY_MODEL=openai/gpt-oss-20b
AGENT_TECHNOLOGY_MAX_OUTPUT_TOKENS=4096
AGENT_TECHNOLOGY_TIMEOUT_MS=60000
AGENT_TECHNOLOGY_INPUT_COST_PER_MILLION=
AGENT_TECHNOLOGY_OUTPUT_COST_PER_MILLION=
AGENT_MILESTONES_API_KEY=
AGENT_MILESTONES_MODEL=openai/gpt-oss-120b
AGENT_MILESTONES_MAX_OUTPUT_TOKENS=4096
AGENT_MILESTONES_TIMEOUT_MS=60000

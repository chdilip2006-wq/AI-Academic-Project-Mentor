AGENT_RISKS_TIMEOUT_MS=60000
AGENT_RISKS_INPUT_COST_PER_MILLION=
AGENT_RISKS_OUTPUT_COST_PER_MILLION=
AI_DEFAULT_TIMEOUT_MS=60000
AI_DEFAULT_MAX_OUTPUT_TOKENS=4096
AI_MAX_AGENT_REQUESTS_PER_PROJECT=25
AI_MAX_TOKENS_PER_PROJECT=100000
AI_PLANNING_LOCK_TTL_SECONDS=1200

MONGODB_URI=
MONGODB_DATABASE=ai_academic_project_mentor
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
# Create a key in GroqCloud and keep it only in this backend environment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional task-specific model and key overrides. Empty agent keys fall back to GROQ_API_KEY.
